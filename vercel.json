{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/checkin",
      "destination": "/self-checkin.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/feedback/print",
      "destination": "/feedback-print.html"
    },
    {
      "source": "/feedback/barcode",
      "destination": "/feedback-print.html"
    },
    {
      "source": "/standee-feedback",
      "destination": "/feedback-print.html"
    },
    {
      "source": "/standee",
      "destination": "/standee.html"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/scanner",
      "destination": "/scanner.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
